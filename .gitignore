# Build outputs
*.zip
*.apk
*.idsig

# Allow module payload APKs for Git LFS
!system/**/*.apk
!payload/**/*.apk

# Development tools
android-sdk/
erofs-utils/
payload-dumper-go
payload-dumper-go_*.tar.gz

# Extracted ROM files
rom/
extracted_new/

# Local-only notes and validation helpers
archive/
docs/
scripts/
tests/
!scripts/
scripts/*
!scripts/build_zygisk.sh
!scripts/test_dualwake_boot.sh
!scripts/test_mount_scrub.sh
!scripts/test_aicall_defaulton.sh
zygisk-src/libs/
zygisk-src/obj/
zygisk-src/build/
zygisk-src/gen/
zygisk-src/test/hooker/build/
zygisk-src/vendor/dobby/src/
zygisk-src/vendor/dobby/build/
.tmp-verify/

# Python virtual environment
.venv/

# IDE
.vscode/
.idea/
*.iml

# Debug logs
*.log
*.txt
!lang/*.txt
!excluded_packages.txt

# Debug scripts (development only)
capture_logs_auto.sh
debug_crash.sh
debug_runtime.sh

# OS generated
.DS_Store
Thumbs.db

# host mock test binary (built by zygisk-src/test/run_test.sh)
zygisk-src/test/test_runner
