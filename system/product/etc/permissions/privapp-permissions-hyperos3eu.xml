<?xml version="1.0" encoding="utf-8"?>
<!-- CN 308 的 priv-app 授權備份：contentextension 來自 CN
     product/etc/permissions/privapp-permissions-product.xml；soundrecorder 來自
     CN system/etc/permissions/privapp-permissions-qti.xml。
     xiaomi.eu 308 底包已內建相同授權，此檔僅作保底（其他 EU 底包可能缺）。 -->
<permissions>
    <privapp-permissions package="com.miui.contentextension">
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.READ_CLIPBOARD_IN_BACKGROUND"/>
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND"/>
    </privapp-permissions>
    <privapp-permissions package="com.android.soundrecorder">
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT"/>
    </privapp-permissions>
</permissions>
